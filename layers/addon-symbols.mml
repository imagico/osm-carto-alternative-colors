  - id: addon-symbols-shelter
    geometry: point
    <<: *extents
    Datasource:
      <<: *osm2pgsql
      table: |-
        (SELECT
            way,
            feature,
            osm_id_shelter,
            osm_id
          FROM
            (SELECT
                way,
                CASE
                  WHEN highway = 'bus_stop' THEN 'bus_stop_shelter'
                  WHEN railway = 'halt' THEN 'railway_halt_shelter'
                  WHEN railway = 'tram_stop' THEN 'tram_stop_shelter'
                END AS feature,
                COALESCE(
                  (SELECT
                      osm_id
                    FROM planet_osm_polygon s
                    WHERE ST_DWithin(p.way, s.way, 28.0*NULLIF(!scale_denominator!*0.001*0.28,0))
                      AND amenity = 'shelter'
                    ORDER BY ST_Distance(p.way, s.way) ASC, osm_id ASC LIMIT 1
                  ),
                  (SELECT
                      osm_id
                    FROM planet_osm_point s
                    WHERE ST_DWithin(p.way, s.way, 28.0*NULLIF(!scale_denominator!*0.001*0.28,0))
                      AND amenity = 'shelter'
                    ORDER BY ST_Distance(p.way, s.way) ASC, osm_id ASC LIMIT 1
                  ),
                  CASE WHEN implicit_shelter = 'yes' AND highway = 'bus_stop' THEN 0 ELSE NULL END
                ) AS osm_id_shelter,
                osm_id
              FROM
                (SELECT
                    way,
                    highway,
                    railway,
                    CASE WHEN (tags->'shelter') = 'yes' THEN 'yes' ELSE 'no' END AS implicit_shelter,
                    osm_id
                  FROM planet_osm_point
                  WHERE way && !bbox!
                UNION ALL
                SELECT
                    ST_PointOnSurface(way) AS way,
                    highway,
                    railway,
                    CASE WHEN (tags->'shelter') = 'yes' THEN 'yes' ELSE 'no' END AS implicit_shelter,
                    osm_id
                  FROM planet_osm_polygon
                  WHERE way && !bbox!) AS p
              WHERE highway = 'bus_stop' OR railway = 'halt' OR railway = 'tram_stop'
            ) AS _
          WHERE osm_id_shelter IS NOT NULL
        ) AS addon_symbols_shelter
    properties:
      minzoom: 16
  - id: addon-symbols-parking
    geometry: point
    <<: *extents
    Datasource:
      geometry_table: planet_osm_point
      <<: *osm2pgsql
      table: |-
        (SELECT
            way,
            feature,
            addon,
            shopping,
            fee,
            lit,
            supervised,
            disabled,
            women,
            parent,
            capacity,
            covered,
            osm_id
          FROM
            (WITH parking_points AS
              (SELECT
                  ST_SnapToGrid(
                    way,
                    NULLIF(!scale_denominator!*0.001*0.28,0), NULLIF(!scale_denominator!*0.001*0.28,0)) AS way,
                  CASE WHEN amenity = 'parking' AND parking IN ('street_side', 'lane') THEN
                    'parking_minor'
                  ELSE
                    amenity
                  END AS feature,
                  CASE WHEN access IN ('private', 'no', 'permit', 'delivery') THEN 'restricted' ELSE 'yes' END AS int_access,
                  CASE WHEN access = 'customers' THEN 'yes' ELSE 'no' END AS shopping,
                  CASE WHEN fee = 'yes' THEN carto_currency_symbol(carto_local_currency(way)) ELSE 'no' END AS fee,
                  CASE WHEN lit = 'yes' THEN 'yes' ELSE 'no' END AS lit,
                  CASE WHEN supervised = 'yes' THEN 'yes' ELSE 'no' END AS supervised,
                  CASE WHEN disabled ~ '^[0-9]{1,4}$' AND disabled != '0' THEN disabled WHEN disabled = 'yes' THEN 'yes' ELSE 'no' END AS disabled,
                  CASE WHEN women ~ '^[0-9]{1,4}$' AND women != '0' THEN women WHEN women = 'yes' THEN 'yes' ELSE 'no' END AS women,
                  CASE WHEN parent ~ '^[0-9]{1,4}$' AND parent != '0' THEN parent WHEN parent = 'yes' THEN 'yes' ELSE 'no' END AS parent,
                  CASE WHEN capacity ~ '^[0-9]{1,4}$' THEN capacity::INTEGER ELSE 0 END AS capacity,
                  CASE WHEN parking = 'multi-storey' OR covered = 'yes' THEN 'yes' ELSE 'no' END AS covered,
                  osm_id
                FROM
                  (SELECT
                      way,
                      amenity,
                      access,
                      tags->'covered' AS covered,
                      tags->'fee' AS fee,
                      tags->'lit' AS lit,
                      tags->'supervised' AS supervised,
                      tags->'parking' AS parking,
                      tags->'capacity:disabled' AS disabled,
                      tags->'capacity:women' AS women,
                      tags->'capacity:parent' AS parent,
                      tags->'capacity' AS capacity,
                      osm_id
                    FROM planet_osm_point
                    WHERE way && !bbox!
                  UNION ALL
                  SELECT
                      ST_PointOnSurface(way) AS way,
                      amenity,
                      access,
                      tags->'covered' AS covered,
                      tags->'fee' AS fee,
                      tags->'lit' AS lit,
                      tags->'supervised' AS supervised,
                      tags->'parking' AS parking,
                      tags->'capacity:disabled' AS disabled,
                      tags->'capacity:women' AS women,
                      tags->'capacity:parent' AS parent,
                      tags->'capacity' AS capacity,
                      osm_id
                    FROM planet_osm_polygon
                    WHERE way && !bbox!) AS p
                WHERE
                  (amenity IN ('parking') AND
                    (access IN ('customers', 'private', 'no', 'permit', 'delivery') OR
                      covered = 'yes' OR
                      fee = 'yes' OR
                      lit = 'yes' OR
                      supervised = 'yes' OR
                      disabled IS NOT NULL OR
                      women IS NOT NULL OR
                      parent IS NOT NULL OR
                      capacity IS NOT NULL OR
                      parking = 'multi-storey')) OR
                  (amenity IN ('motorcycle_parking', 'bicycle_parking') AND
                    (access IN ('customers', 'private', 'no', 'permit', 'delivery') OR
                      covered = 'yes' OR
                      fee = 'yes' OR
                      lit = 'yes' OR
                      supervised = 'yes' OR
                      capacity IS NOT NULL))
              )
              SELECT
                  way,
                  feature,
                  1 AS priority,
                  'private' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE int_access = 'restricted'
              UNION ALL
              SELECT
                  way,
                  feature,
                  2 AS priority,
                  'covered' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE covered != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  3 AS priority,
                  'disabled' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE disabled != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  4 AS priority,
                  'parent' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE parent != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  5 AS priority,
                  'women' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE women != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  6 AS priority,
                  'lit' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE lit != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  7 AS priority,
                  'shopping' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE shopping != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  8 AS priority,
                  'supervised' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE supervised != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  9 AS priority,
                  'fee' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE fee != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  10 AS priority,
                  'capacity' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE capacity > 0 AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  11 AS priority,
                  'disabled_text' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE disabled NOT IN('yes', 'no') AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  12 AS priority,
                  'parent_text' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE parent NOT IN('yes', 'no') AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  13 AS priority,
                  'women_text' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE women NOT IN('yes', 'no') AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  14 AS priority,
                  'lit2' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE lit != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  15 AS priority,
                  'shopping2' AS addon,
                  shopping,
                  fee,
                  lit,
                  supervised,
                  disabled,
                  women,
                  parent,
                  capacity,
                  covered,
                  osm_id
                FROM parking_points
                WHERE shopping != 'no' AND int_access = 'yes'
            ) AS _
          ORDER BY priority
        ) AS addon_symbols_parking
    properties:
      minzoom: 17
  - id: addon-symbols-chargingstation
    geometry: point
    <<: *extents
    Datasource:
      geometry_table: planet_osm_point
      <<: *osm2pgsql
      table: |-
        (SELECT
            way,
            feature,
            addon,
            capacity,
            covered,
            vehicles,
            parking,
            socket_output,
            socket_capacity,
            osm_id
          FROM
            (WITH chargingstation_points AS
              (SELECT
                  ST_SnapToGrid(
                    way,
                    NULLIF(!scale_denominator!*0.001*0.28,0), NULLIF(!scale_denominator!*0.001*0.28,0)) AS way,
                  amenity AS feature,
                  int_access,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  -- only set when value differs from total capacity (so we only show a separate label in that case)
                  CASE WHEN socket_type1 NOT IN ('yes', 'no') AND socket_type1::INTEGER != capacity THEN socket_type1 ELSE 'no' END AS socket_type1,
                  CASE WHEN socket_type1_combo NOT IN ('yes', 'no') AND socket_type1_combo::INTEGER != capacity THEN socket_type1_combo ELSE 'no' END AS socket_type1_combo,
                  CASE WHEN socket_type2 NOT IN ('yes', 'no') AND socket_type2::INTEGER != capacity THEN socket_type2 ELSE 'no' END AS socket_type2,
                  CASE WHEN socket_type2_combo NOT IN ('yes', 'no') AND socket_type2_combo::INTEGER != capacity THEN socket_type2_combo ELSE 'no' END AS socket_type2_combo,
                  CASE WHEN socket_chademo NOT IN ('yes', 'no') AND socket_chademo::INTEGER != capacity THEN socket_chademo ELSE 'no' END AS socket_chademo,
                  CASE WHEN socket_nacs NOT IN ('yes', 'no') AND socket_nacs::INTEGER != capacity THEN socket_nacs ELSE 'no' END AS socket_nacs,
                  -- power classification decides the socket symbol vis - so we only set it if the socket type is present
                  CASE WHEN socket_type1 != 'no' THEN
                    CASE
                      WHEN socket_type1_output > 200 THEN 'high'
                      WHEN socket_type1_output > 50 THEN 'medium'
                      ELSE 'low'
                    END
                  END AS socket_type1_output,
                  CASE WHEN socket_type1_combo != 'no' THEN
                    CASE
                      WHEN socket_type1_combo_output > 200 THEN 'high'
                      WHEN socket_type1_combo_output > 50 THEN 'medium'
                      ELSE 'low'
                    END
                  END AS socket_type1_combo_output,
                  CASE WHEN socket_type2 != 'no' THEN
                    CASE
                      WHEN socket_type2_output > 200 THEN 'high'
                      WHEN socket_type2_output > 50 THEN 'medium'
                      ELSE 'low'
                    END
                  END AS socket_type2_output,
                  CASE WHEN socket_type2_combo != 'no' THEN
                    CASE
                      WHEN socket_type2_combo_output > 200 THEN 'high'
                      WHEN socket_type2_combo_output > 50 THEN 'medium'
                      ELSE 'low'
                    END
                  END AS socket_type2_combo_output,
                  CASE WHEN socket_chademo != 'no' THEN
                    CASE
                      WHEN socket_chademo_output > 200 THEN 'high'
                      WHEN socket_chademo_output > 50 THEN 'medium'
                      ELSE 'low'
                    END
                  END AS socket_chademo_output,
                  CASE WHEN socket_nacs != 'no' THEN
                    CASE
                      WHEN socket_nacs_output > 200 THEN 'high'
                      WHEN socket_nacs_output > 50 THEN 'medium'
                      ELSE 'low'
                    END
                  END AS socket_nacs_output,
                  osm_id
                FROM
                  (SELECT
                      way,
                      amenity,
                      CASE WHEN access IN ('private', 'no', 'permit', 'delivery') THEN 'restricted' ELSE 'yes' END AS int_access,
                      COALESCE(capacity::INTEGER, 0) AS capacity,
                      CASE WHEN covered = 'yes' THEN 'yes' ELSE 'no' END AS covered,
                      CASE
                        WHEN bicycle IN ('yes', 'designated') THEN (CASE WHEN motorcar = 'no' THEN 'bicycle' ELSE 'bicycle+car' END)
                        WHEN motorcycle IN ('yes', 'designated') THEN (CASE WHEN motorcar = 'no' THEN 'motorcycle' ELSE 'motorcycle+car' END)
                      END AS vehicles,
                      CASE WHEN parking_fee = 'no' OR maxstay IN ('no', 'unlimited') THEN 'yes' ELSE 'no' END AS parking,
                      CASE
                        WHEN (socket_type1 ~ '^[0-9]{1,4}$' AND socket_type1 != '0') OR socket_type1 = 'yes' THEN socket_type1 ELSE 'no'
                      END AS socket_type1,
                      CASE
                        WHEN (socket_type1_combo ~ '^[0-9]{1,4}$' AND socket_type1_combo != '0') OR socket_type1_combo = 'yes' THEN socket_type1_combo ELSE 'no'
                      END AS socket_type1_combo,
                      CASE
                        WHEN (socket_type2 ~ '^[0-9]{1,4}$' AND socket_type2 != '0') OR socket_type2 = 'yes' THEN socket_type2 ELSE 'no'
                      END AS socket_type2,
                      CASE
                        WHEN (socket_type2_combo ~ '^[0-9]{1,4}$' AND socket_type2_combo != '0') OR socket_type2_combo = 'yes' THEN socket_type2_combo ELSE 'no'
                      END AS socket_type2_combo,
                      CASE
                        WHEN (socket_chademo ~ '^[0-9]{1,4}$' AND socket_chademo != '0') OR socket_chademo = 'yes' THEN socket_chademo ELSE 'no'
                      END AS socket_chademo,
                      CASE
                        WHEN (socket_nacs ~ '^[0-9]{1,4}$' AND socket_nacs != '0') OR socket_nacs = 'yes' THEN socket_nacs ELSE 'no'
                      END AS socket_nacs,
                      -- expect either plain decimal number (in kW) or semicolon separated list of numbers (take only first) or number + unit (with unit bein kW)
                      CASE
                        WHEN socket_type1_output ~ '^\d{1,4}(\.\d+)?$' THEN socket_type1_output::float
                        WHEN socket_type1_output ~ '^\d{1,4}(\.\d+)?;' THEN substring(socket_type1_output from '(^\d{1,4}(\.\d+)?)')::float
                        WHEN socket_type1_output ~ '^\d{1,4}(\.\d+)?( )?kW' THEN substring(socket_type1_output from '(^\d{1,4}(\.\d+)?)')::float
                      END AS socket_type1_output,
                      CASE
                        WHEN socket_type1_combo_output ~ '^\d{1,4}(\.\d+)?$' THEN socket_type1_combo_output::float
                        WHEN socket_type1_combo_output ~ '^\d{1,4}(\.\d+)?;' THEN substring(socket_type1_combo_output from '(^\d{1,4}(\.\d+)?)')::float
                        WHEN socket_type1_combo_output ~ '^\d{1,4}(\.\d+)?( )?kW' THEN substring(socket_type1_combo_output from '(^\d{1,4}(\.\d+)?)')::float
                      END AS socket_type1_combo_output,
                      CASE
                        WHEN socket_type2_output ~ '^\d{1,4}(\.\d+)?$' THEN socket_type2_output::float
                        WHEN socket_type2_output ~ '^\d{1,4}(\.\d+)?;' THEN substring(socket_type2_output from '(^\d{1,4}(\.\d+)?)')::float
                        WHEN socket_type2_output ~ '^\d{1,4}(\.\d+)?( )?kW' THEN substring(socket_type2_output from '(^\d{1,4}(\.\d+)?)')::float
                      END AS socket_type2_output,
                      CASE
                        WHEN socket_type2_combo_output ~ '^\d{1,4}(\.\d+)?$' THEN socket_type2_combo_output::float
                        WHEN socket_type2_combo_output ~ '^\d{1,4}(\.\d+)?;' THEN substring(socket_type2_combo_output from '(^\d{1,4}(\.\d+)?)')::float
                        WHEN socket_type2_combo_output ~ '^\d{1,4}(\.\d+)?( )?kW' THEN substring(socket_type2_combo_output from '(^\d{1,4}(\.\d+)?)')::float
                      END AS socket_type2_combo_output,
                      CASE
                        WHEN socket_chademo_output ~ '^\d{1,4}(\.\d+)?$' THEN socket_chademo_output::float
                        WHEN socket_chademo_output ~ '^\d{1,4}(\.\d+)?;' THEN substring(socket_chademo_output from '(^\d{1,4}(\.\d+)?)')::float
                        WHEN socket_chademo_output ~ '^\d{1,4}(\.\d+)?( )?kW' THEN substring(socket_chademo_output from '(^\d{1,4}(\.\d+)?)')::float
                      END AS socket_chademo_output,
                      CASE
                        WHEN socket_nacs_output ~ '^\d{1,4}(\.\d+)?$' THEN socket_nacs_output::float
                        WHEN socket_nacs_output ~ '^\d{1,4}(\.\d+)?;' THEN substring(socket_nacs_output from '(^\d{1,4}(\.\d+)?)')::float
                        WHEN socket_nacs_output ~ '^\d{1,4}(\.\d+)?( )?kW' THEN substring(socket_nacs_output from '(^\d{1,4}(\.\d+)?)')::float
                      END AS socket_nacs_output,
                      osm_id
                    FROM
                      (SELECT
                          way,
                          amenity,
                          access,
                          tags->'covered' AS covered,
                          tags->'capacity' AS capacity,
                          tags->'parking:fee' AS parking_fee,
                          tags->'motorcar' AS motorcar,
                          tags->'motorcycle' AS motorcycle,
                          tags->'bicycle' AS bicycle,
                          tags->'maxstay' AS maxstay,
                          tags->'socket:type1' AS socket_type1,
                          tags->'socket:type1:output' AS socket_type1_output,
                          tags->'socket:type1_combo' AS socket_type1_combo,
                          tags->'socket:type1_combo:output' AS socket_type1_combo_output,
                          tags->'socket:type2' AS socket_type2,
                          tags->'socket:type2:output' AS socket_type2_output,
                          tags->'socket:type2_combo' AS socket_type2_combo,
                          tags->'socket:type2_combo:output' AS socket_type2_combo_output,
                          tags->'socket:chademo' AS socket_chademo,
                          tags->'socket:chademo:output' AS socket_chademo_output,
                          tags->'socket:nacs' AS socket_nacs,
                          tags->'socket:nacs:output' AS socket_nacs_output,
                          osm_id
                        FROM planet_osm_point
                        WHERE way && !bbox!
                      UNION ALL
                      SELECT
                          ST_PointOnSurface(way) AS way,
                          amenity,
                          access,
                          tags->'covered' AS covered,
                          tags->'capacity' AS capacity,
                          tags->'parking:fee' AS parking_fee,
                          tags->'motorcar' AS motorcar,
                          tags->'motorcycle' AS motorcycle,
                          bicycle,
                          tags->'maxstay' AS maxstay,
                          tags->'socket:type1' AS socket_type1_output,
                          tags->'socket:type1:output' AS socket_type1_output,
                          tags->'socket:type1_combo' AS socket_type1_combo,
                          tags->'socket:type1_combo:output' AS socket_type1_combo_output,
                          tags->'socket:type2' AS socket_type2_output,
                          tags->'socket:type2:output' AS socket_type2_output,
                          tags->'socket:type2_combo' AS socket_type2_combo,
                          tags->'socket:type2_combo:output' AS socket_type2_combo_output,
                          tags->'socket:chademo' AS socket_chademo,
                          tags->'socket:chademo:output' AS socket_chademo_output,
                          tags->'socket:nacs' AS socket_nacs,
                          tags->'socket:nacs:output' AS socket_nacs_output,
                          osm_id
                        FROM planet_osm_polygon
                        WHERE way && !bbox!) AS p
                    WHERE amenity = 'charging_station'
                  ) AS _
              )
              SELECT
                  way,
                  feature,
                  1 AS priority,
                  'private' AS addon,
                  0 AS capacity,
                  'no' AS covered,
                  NULL AS vehicles,
                  'no' AS parking,
                  NULL AS socket_output,
                  'no' AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE int_access = 'restricted'
              UNION ALL
              SELECT
                  way,
                  feature,
                  2 AS priority,
                  'covered' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  NULL AS socket_output,
                  'no' AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE covered != 'no' AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  3 AS priority,
                  'capacity' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  NULL AS socket_output,
                  'no' AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE capacity > 0 AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  4 AS priority,
                  'vehicles' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  NULL AS socket_output,
                  'no' AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE vehicles IS NOT NULL AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  5 AS priority,
                  'socket_type2_combo' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  socket_type2_combo_output AS socket_output,
                  socket_type2_combo AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE socket_type2_combo_output IS NOT NULL AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  6 AS priority,
                  'socket_type2' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  socket_type2_output AS socket_output,
                  socket_type2 AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE socket_type2_output IS NOT NULL AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  7 AS priority,
                  'socket_nacs' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  socket_nacs_output AS socket_output,
                  socket_nacs AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE socket_nacs_output IS NOT NULL AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  8 AS priority,
                  'socket_type1_combo' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  socket_type1_combo_output AS socket_output,
                  socket_type1_combo AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE socket_type1_combo_output IS NOT NULL AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  9 AS priority,
                  'socket_type1' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  socket_type1_output AS socket_output,
                  socket_type1 AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE socket_type1_output IS NOT NULL AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  10 AS priority,
                  'socket_chademo' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  socket_chademo_output AS socket_output,
                  socket_chademo AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE socket_chademo_output IS NOT NULL AND int_access = 'yes'
              UNION ALL
              SELECT
                  way,
                  feature,
                  11 AS priority,
                  'parking' AS addon,
                  capacity,
                  covered,
                  vehicles,
                  parking,
                  NULL AS socket_output,
                  'no' AS socket_capacity,
                  osm_id
                FROM chargingstation_points
                WHERE parking = 'yes' AND int_access = 'yes'
            ) AS _
          ORDER BY priority
        ) AS addon_symbols_chargingstation
    properties:
      minzoom: 17
  - id: addon-symbols-water
    geometry: point
    <<: *extents
    Datasource:
      <<: *osm2pgsql
      table: |-
        (SELECT
            way,
            feature,
            drinking_water,
            watering_place,
            (CASE WHEN az < 180 THEN -1.0 ELSE 1.0 END)*(CASE WHEN az BETWEEN 60 AND 300 THEN 7 ELSE 9 END)*dist_scale AS dwxdist,
            (CASE WHEN az BETWEEN 60 AND 300 THEN -5 ELSE 0 END)*dist_scale AS dwydist,
            (CASE WHEN az < 180 THEN -1.0 ELSE 1.0 END)*(CASE WHEN az BETWEEN 60 AND 300 THEN 9 ELSE 7 END)*dist_scale AS dwxdist2,
            (CASE WHEN az BETWEEN 60 AND 300 THEN 0 ELSE -5 END)*dist_scale AS dwydist2,
            (CASE WHEN az < 180 THEN -1.0 ELSE 1.0 END)*(CASE WHEN az BETWEEN 60 AND 300 THEN 9 ELSE 3.5 END)*dist_scale AS wpxdist,
            (CASE WHEN az BETWEEN 60 AND 300 THEN -3 ELSE 7.2 END)*dist_scale AS wpydist,
            (CASE WHEN az < 180 THEN -1.0 ELSE 1.0 END)*(CASE WHEN az BETWEEN 60 AND 300 THEN 3.5 ELSE 9 END)*dist_scale AS wpxdist2,
            (CASE WHEN az BETWEEN 60 AND 300 THEN 7.2 ELSE -3 END)*dist_scale AS wpydist2,
            osm_id
          FROM
            (SELECT
                way,
                feature,
                drinking_water,
                watering_place,
                COALESCE(dir_width[1], CASE WHEN feature = 'watering_place' THEN 240 ELSE 120 END) AS az,
                GREATEST(COALESCE(dir_width[2], 7.5), 7.5)/7.5 AS dist_scale,
                osm_id
              FROM
                (SELECT
                    way,
                    CASE
                      WHEN ("natural" IN ('spring', 'hot_spring')) THEN "natural"
                      WHEN (man_made IN ('water_well')) THEN man_made
                      ELSE amenity
                    END AS feature,
                    CASE WHEN (amenity = 'drinking_water' OR drinking_water = 'yes') THEN 'yes' ELSE 'no' END AS drinking_water,
                    CASE WHEN ("natural" IN ('spring', 'hot_spring') OR man_made IN ('water_well')) AND (amenity = 'watering_place') THEN 'yes' ELSE 'no' END AS watering_place,
                    CASE WHEN "natural" IN ('spring', 'hot_spring') THEN
                      (SELECT
                          ARRAY[
                            -- this determines the direction of a point on the waterway(s) intersecting the node with a 1 pixel circle around the node
                            -- which approximates the direction of the waterway, hence where best not to place the addon symbol
                            degrees(ST_Azimuth(p.way, ST_PointOnSurface(ST_Intersection(ST_Boundary(ST_Buffer(p.way, 1.0*NULLIF(!scale_denominator!*0.001*0.28,0))), ST_Collect(l.way))))),
                            MAX(carto_waterway_line_width(l.waterway, z(!scale_denominator!)))
                          ]
                        FROM planet_osm_line l
                        WHERE ST_DWithin(p.way, l.way, 0.1) AND l.waterway IN ('river', 'canal', 'stream', 'ditch', 'drain')
                      )
                    ELSE
                      ARRAY[NULL::numeric, NULL::numeric]
                    END AS dir_width,
                    osm_id
                  FROM
                    (SELECT
                        way,
                        "natural",
                        man_made,
                        amenity,
                        tags->'drinking_water' AS drinking_water,
                        osm_id
                      FROM planet_osm_point
                      WHERE way && !bbox!
                    UNION ALL
                    SELECT
                        ST_PointOnSurface(way) AS way,
                        "natural",
                        man_made,
                        amenity,
                        tags->'drinking_water' AS drinking_water,
                        osm_id
                      FROM planet_osm_polygon
                      WHERE way && !bbox!) AS p
                  WHERE ("natural" IN ('spring', 'hot_spring') OR man_made IN ('water_well') OR amenity IN ('fountain', 'watering_place'))
                    AND (amenity IN ('drinking_water', 'watering_place') OR drinking_water = 'yes')
                ) AS raw
            ) AS _
        ) AS addon_symbols_water
    properties:
      minzoom: 17
