  - id: roads
    <<: *extents
    Datasource:
      <<: *osm2pgsql
      geometry_table: planet_osm_line
      # This is one of the most complex layers, so it bears explaining in some detail
      # It is necessary to
      # - Have roads and railways in the same layer to get ordering right
      # - Return two linestrings for ways which are both a road and railway
      # - Compute z_order here, rather than rely on osm2pgsql z_order
      table: &roads_sql |-
        (SELECT
            way,
            road_layer,
            feature,
            path_type,
            intermittent,
            seasonal,
            int_surface,
            int_tunnel,
            int_bridge,
            int_lanes,
            int_access,
            construction,
            service,
            link,
            connect_type,
            width_lane,
            width_nominal,
            width_max,
            width,
            casing_width
          FROM ( -- this wraps all the different road sublayers, most of which are mostly sourced from the same CTEs (roads_all, road_areas_all, tc_all)
            WITH roads_all AS -- roads_all is based on the classic roads-casing/roads-fill/bridges layers + junction polygons
            (
              WITH roads_prepared AS -- roads_prepared is all roads, preprocessed including junctions, sidewalks, lanes and line cap splits but with no bridge connects yet
              (SELECT
                  way,
                  (CASE WHEN substr(feature, length(feature)-4, 5) = '_link' THEN substr(feature, 0, length(feature)-4) ELSE feature END) AS feature,
                  path_type,
                  int_surface,
                  int_tunnel,
                  int_bridge,
                  int_lane,
                  int_lanes,
                  int_access,
                  construction,
                  service,
                  link,
                  connect_type,
                  width_lane,
                  width_nominal,
                  CASE WHEN int_tunnel = 'no' THEN GREATEST(width_nominal, width_tagged) ELSE width_nominal END AS width_max,
                  CASE WHEN (width_tagged > width_nominal) THEN width_tagged ELSE 0.0 END AS width,
                  casing_width,
                  layernotnull,
                  osm_id,
                  carto_z_order_from_feature(feature, construction) AS z_order
                FROM ( -- begin "features" subselect that contains both roads and rail/aero
                  WITH highways_raw AS
                  -- this queries all roads from the database together with the corresponding width values
                  -- to be used both directly and for the sidewalk geometries
                  (
                    @@include(roads/highways_raw.sql)
                  ), -- end highways_raw CTE
                  aeroways_raw AS
                  (
                    @@include(roads/aeroways_raw.sql)
                  ), -- end aeroways_raw CTE
                  junctions AS
                  (
                  @@if(road_basic)
                    @@include(roads/junctions-dummy.sql)
                  @@else
                    @@include(roads/junctions.sql)
                  @@end
                  ), -- end junctions CTE
                  highways_all AS
                  (
                  @@if(road_basic)
                    @@include(roads/highways_all-simple.sql)
                  @@else
                    @@include(roads/highways_all.sql)
                  @@end
                  ), -- end highways_all CTE
                @@if(ac)
                  sidewalks_raw AS
                  (
                    @@include(roads/sidewalks-cte.sql)
                  )  -- end sidewalks_raw CTE
                  @@include(roads/sidewalks.sql)
                  UNION ALL
                  @@include(roads/lanes.sql)
                @@else
                  @@include(roads/sidewalks-dummy.sql)
                @@end
                  UNION ALL
                  SELECT -- begin of main road select
                      way,
                      feature,
                      path_type,
                      int_surface,
                      int_tunnel,
                      int_bridge,
                      'no' AS int_lane,
                      int_lanes,
                      int_access,
                      construction,
                      service,
                      link,
                      connect_type,
                      width_lane,
                      width_nominal,
                      width_tagged,
                      casing_width,
                      layernotnull,
                      osm_id,
                      z_order
                    FROM highways_all
                    -- end of main road select
                  UNION ALL
                  SELECT -- begin of junction polygons select
                      way,
                      feature,
                      path_type,
                      int_surface,
                      int_tunnel,
                      int_bridge,
                      'no' AS int_lane,
                      int_lanes,
                      int_access,
                      construction,
                      service,
                      link,
                      'junction' AS connect_type,
                      0 AS width_lane,
                      width_nominal,
                      width_tagged,
                      casing_width,
                      layernotnull,
                      osm_id,
                      z_order
                    FROM junctions
                    -- end of junction polygons select
                  UNION ALL
                @@if(road_basic)
                  @@include(roads/fords-dummy.sql)
                @@else
                  @@include(roads/fords.sql)
                @@end
                  UNION ALL
                @@if(road_basic)
                  @@include(roads/crossings-dummy.sql)
                @@else
                  @@include(roads/crossings.sql)
                @@end
                  UNION ALL
                  @@include(roads/railways_all.sql)
                ) AS roads_features
              ) -- end of roads_prepared CTE
              SELECT
                  way,
                  feature,
                  path_type,
                  int_surface,
                  int_tunnel,
                  int_bridge,
                  int_lane,
                  int_lanes,
                  int_access,
                  construction,
                  service,
                  link,
                  connect_type,
                  width_lane,
                  width_nominal,
                  width_max,
                  width,
                  casing_width,
                  layernotnull,
                  osm_id,
                  z_order
                FROM roads_prepared
            @@if(ac)
              UNION ALL
              @@include(roads/bridge-connects.sql)
            @@end
            ), -- end of roads_all CTE
            road_areas_all AS
            (
              @@include(roads/road_areas.sql)
            ), -- end of road_areas_all CTE
            tc_all AS
            (
              @@include(roads/tc.sql)
            ), -- end of tc_all CTE
            piers_poly_all AS
            (
              @@include(roads/piers_poly.sql)
            ), -- end of piers_poly_all CTE
            piers_line_all AS
            (
              @@include(roads/piers_line.sql)
            ), -- end of piers_line_all CTE
            line_barriers_all AS
            (
            @@if(ac)
              @@include(roads/line-barriers.sql)
            @@else
              @@include(roads/line-barriers-simple.sql)
            @@end
            ), -- end of line_barriers_all CTE
            pipelines_all AS
            (
            @@if(ac)
              @@include(roads/pipelines.sql)
            @@else
              @@include(roads/pipelines-simple.sql)
            @@end
            ) -- end of pipelines_all CTE
            SELECT -- casing
                way,
                'casing' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_lane = 'no'
                AND connect_type NOT IN ('flat_end_fill', 'flat_end_fill_background', 'crossing', 'junction')
                AND (
                  int_bridge = 'no' OR
                  connect_type NOT IN ('line_separate')
                )
            UNION ALL
            SELECT -- background
                way,
                'background' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_lane = 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'crossing', 'junction')
                AND (
                  int_bridge = 'no' OR
                  connect_type IN ('bridge_connect') OR
                  feature NOT IN ('highway_track', 'highway_path', 'highway_footway', 'highway_cycleway', 'highway_bridleway') OR
                  width = 0.0 OR
                  z(!scale_denominator!) < 18
                )
            UNION ALL
            SELECT -- background_bridge
                CASE
                  WHEN connect_type = 'flat_end_fill' THEN
                    ST_Buffer(way, 0.5*(width_max - 2.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round')
                  ELSE
                    CASE
                      WHEN width_max > 4.0*casing_width THEN
                        ST_Buffer(ST_Buffer(way, 0.5*(width_max - 4.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round'), casing_width*NULLIF(!scale_denominator!*0.001*0.28,0))
                      WHEN z(!scale_denominator!) < 14 THEN
                        ST_Buffer(way, 0.5*(width_max - 2.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0))
                    ELSE -- enlarge the fill if line width is very small to prevent the heavy bridge casing drowning the fill line
                      ST_Buffer(way, 0.5*(width_max - 1.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0))
                    END
                END AS way,
                'background_bridge' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_tunnel = 'no'
                AND int_lane = 'no'
                AND int_bridge != 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'crossing', 'junction', 'bridge_connect')
                AND feature IN ('highway_track', 'highway_path', 'highway_footway', 'highway_cycleway', 'highway_bridleway')
                AND width > 0.0
                AND z(!scale_denominator!) >= 18
            UNION ALL
            SELECT -- fill (non-bridge, bridge_connect)
                way,
                'fill' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_lane = 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'flat_end_fill_background', 'background', 'crossing', 'junction')
                AND (
                  int_bridge = 'no' OR
                  connect_type IN ('bridge_connect') OR
                  z(!scale_denominator!) < 12 OR
                  feature NOT IN (
                    'highway_motorway', 'highway_trunk', 'highway_primary', 'highway_secondary', 'highway_tertiary', 'highway_unclassified',
                    'highway_residential', 'highway_service', 'highway_road', 'highway_pedestrian', 'highway_living_street', 'highway_raceway',
                    'highway_busway', 'highway_bus_guideway',
                    'highway_platform', 'railway_platform', 'aeroway_runway', 'aeroway_taxiway')
                )
            UNION ALL
            SELECT -- fill_bridge
                CASE
                  WHEN feature IN ('aeroway_runway', 'aeroway_taxiway') THEN
                    ST_Buffer(ST_Buffer(way, 0.5*(width_max - 2.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round'), casing_width*NULLIF(!scale_denominator!*0.001*0.28,0))
                  WHEN feature IN ('highway_raceway') THEN
                    CASE WHEN width_max > 2.0*casing_width THEN
                      ST_Buffer(ST_Buffer(way, 0.5*(width_max - 2.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round'), casing_width*NULLIF(!scale_denominator!*0.001*0.28,0))
                    ELSE
                      ST_Buffer(way, 0.5*width_max*NULLIF(!scale_denominator!*0.001*0.28,0))
                    END
                  WHEN connect_type = 'flat_end_fill' THEN
                    ST_Buffer(way, 0.5*(width_max - 2.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round')
                  ELSE
                    CASE
                      WHEN width_max > 4.0*casing_width THEN
                        ST_Buffer(ST_Buffer(way, 0.5*(width_max - 4.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round'), casing_width*NULLIF(!scale_denominator!*0.001*0.28,0))
                      WHEN z(!scale_denominator!) < 14 THEN
                        ST_Buffer(way, 0.5*(width_max - 2.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0))
                    ELSE -- enlarge the fill if line width is very small to prevent the heavy bridge casing drowning the fill line
                      ST_Buffer(way, 0.5*(width_max - 1.0*casing_width)*NULLIF(!scale_denominator!*0.001*0.28,0))
                    END
                END AS way,
                'fill_bridge' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_tunnel = 'no'
                AND int_lane = 'no'
                AND int_bridge != 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'flat_end_fill_background', 'background', 'crossing', 'junction', 'bridge_connect')
                AND
                  -- this is all the roads with a casing+fill design at z12+
                  feature IN (
                    'highway_motorway', 'highway_trunk', 'highway_primary', 'highway_secondary', 'highway_tertiary', 'highway_unclassified',
                    'highway_residential', 'highway_service', 'highway_road', 'highway_pedestrian', 'highway_living_street', 'highway_raceway',
                    'highway_busway', 'highway_bus_guideway',
                    'highway_platform', 'railway_platform', 'aeroway_runway', 'aeroway_taxiway')
                AND z(!scale_denominator!) >= 12
            UNION ALL
            SELECT -- junction_casing
                way,
                'junction_casing' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE connect_type IN ('junction') AND int_lane = 'no'
            UNION ALL
            SELECT -- junction_fill
                way,
                'junction_fill' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE connect_type IN ('junction') AND int_lane = 'no'
            UNION ALL
            SELECT -- fill_lanes
                way,
                'fill_lanes' AS road_layer,
                ('highway_lane_' || int_lane) AS feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_tunnel = 'no'
                AND int_lane != 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'flat_end_fill_background', 'background', 'crossing', 'junction')
                AND z(!scale_denominator!) >= 18
            UNION ALL
            SELECT -- parkings_lane
                way,
                'parkings_lane' AS road_layer,
                'amenity_parking' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                way_area/NULLIF(POW(!scale_denominator!*0.001*0.28,2),0) AS width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                0 AS z_order
              FROM planet_osm_polygon
              WHERE amenity = 'parking' AND (tags->'parking') = 'lane'
                AND building IS NULL
                AND way && !bbox!
                AND z(!scale_denominator!) >= 12
            UNION ALL
            SELECT -- centerline
                way,
                'centerline' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_tunnel = 'no'
                AND int_lane = 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'flat_end_fill_background', 'background', 'crossing', 'junction')
                AND
                  feature IN ('highway_living_street', 'highway_pedestrian', 'highway_busway', 'highway_bus_guideway', 'aeroway_runway', 'aeroway_taxiway')
                AND z(!scale_denominator!) >= 15
            UNION ALL
            SELECT -- lanes
                way,
                'lanes' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_tunnel = 'no'
                AND int_lane = 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'flat_end_fill_background', 'background', 'crossing', 'junction')
                AND int_lanes IS NOT NULL
                AND z(!scale_denominator!) >= 18
            UNION ALL
            SELECT -- access
                way,
                'access' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_tunnel = 'no'
                AND int_access IS NOT NULL
                AND int_lane = 'no'
                AND connect_type NOT IN ('flat_end_fill', 'flat_end_casing', 'flat_end_casing_background', 'flat_end_fill_background', 'background', 'crossing', 'junction')
                AND z(!scale_denominator!) >= 15
            UNION ALL
            SELECT -- centerline_top
                way,
                'centerline_top' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE int_tunnel = 'no'
                AND int_bridge IN ('ford', 'ford_node',  'mountain_pass')
                AND int_lane = 'no'
                AND connect_type NOT IN ('flat_end_casing', 'flat_end_casing_background', 'flat_end_fill_background', 'background', 'crossing', 'junction')
                AND z(!scale_denominator!) >= 15
            UNION ALL
            SELECT -- crossings_background
                way,
                'crossings_background' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE connect_type = 'crossing'
                AND z(!scale_denominator!) >= 15
            UNION ALL
            SELECT -- crossings
                way,
                'crossings' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM roads_all
              WHERE connect_type = 'crossing'
                AND z(!scale_denominator!) >= 15
            UNION ALL
            SELECT -- area_casing
                way,
                'area_casing' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                0 AS width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM road_areas_all
              WHERE feature NOT IN ('aeroway_runway', 'aeroway_taxiway', 'aeroway_helipad')
            UNION ALL
            SELECT -- area_fill
                way,
                'area_fill' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                'null' AS connect_type,
                0 AS width_lane,
                width_nominal,
                width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM road_areas_all
            UNION ALL
            SELECT -- tc_casing
                way,
                'tc_casing' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM tc_all
            UNION ALL
            SELECT -- tc_fill
                way,
                'tc_fill' AS road_layer,
                feature,
                path_type,
                'no' AS intermittent,
                'no' AS seasonal,
                int_surface,
                int_tunnel,
                int_bridge,
                int_lanes,
                int_access,
                construction,
                service,
                link,
                connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                width,
                casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM tc_all
            UNION ALL
            SELECT -- waterway_bridges_casing
                way,
                'waterway_bridges_casing' AS road_layer,
                ('waterway_' || waterway) AS feature,
                'null' AS path_type,
                tags->'intermittent' AS intermittent,
                tags->'seasonal' AS seasonal,
                'null' AS int_surface,
                CASE WHEN tunnel IN ('yes', 'culvert') THEN 'yes' ELSE 'no' END AS int_tunnel,
                'yes' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                0 AS width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                0 AS z_order
              FROM planet_osm_line
              WHERE waterway IN ('river', 'canal', 'stream', 'drain', 'ditch', 'wadi')
                AND bridge IN ('yes', 'aqueduct')
                AND way && !bbox!
                AND z(!scale_denominator!) >= 12
            UNION ALL
            SELECT -- waterway_bridges_fill
                way,
                'waterway_bridges_fill' AS road_layer,
                ('waterway_' || waterway) AS feature,
                'null' AS path_type,
                tags->'intermittent' AS intermittent,
                tags->'seasonal' AS seasonal,
                'null' AS int_surface,
                CASE WHEN tunnel IN ('yes', 'culvert') THEN 'yes' ELSE 'no' END AS int_tunnel,
                'yes' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                0 AS width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                0 AS z_order
              FROM planet_osm_line
              WHERE waterway IN ('river', 'canal', 'stream', 'drain', 'ditch', 'wadi')
                AND bridge IN ('yes', 'aqueduct')
                AND way && !bbox!
                AND z(!scale_denominator!) >= 12
            UNION ALL
            SELECT -- waterway_supplement
                way,
                'waterway_supplement' AS road_layer,
                ('waterway_' || waterway) AS feature,
                'null' AS path_type,
                tags->'intermittent' AS intermittent,
                tags->'seasonal' AS seasonal,
                'null' AS int_surface,
                CASE WHEN tunnel IN ('yes', 'culvert') THEN 'yes' ELSE 'no' END AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                0 AS width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                0 AS z_order
              FROM planet_osm_line
              WHERE waterway IN ('river', 'canal', 'stream', 'drain', 'ditch', 'wadi')
                AND (bridge IS NULL OR bridge NOT IN ('yes', 'aqueduct'))
                AND way && !bbox!
                AND z(!scale_denominator!) >= 14
            UNION ALL
            SELECT -- line_barriers
                way,
                'line_barriers' AS road_layer,
                feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                CASE WHEN height <= 0.5 THEN 'yes' ELSE 'no' END AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                z_order
              FROM line_barriers_all
            UNION ALL
            SELECT -- line_barrier_areas
                ST_Difference(
                  ST_Reverse(ST_OffsetCurve(way, width*0.5*NULLIF(!scale_denominator!*0.001*0.28,0), 'join=round')),
                  COALESCE(
                    (SELECT
                        ST_Union(ST_Buffer(way, width*0.5*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round'))
                      FROM line_barriers_all
                      WHERE feature IN ('barrier_wall', 'barrier_city_wall', 'historic_citywalls')
                        AND osm_id != l1.osm_id
                    ),
                    ST_SetSRID('GEOMETRYCOLLECTION EMPTY'::geometry, 3857)
                  )
                ) AS way,
                'line_barrier_areas' AS road_layer,
                feature,
                'inner' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                CASE WHEN height <= 0.5 THEN 'yes' ELSE 'no' END AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                z_order
              FROM line_barriers_all AS l1
                WHERE z(!scale_denominator!) >= 18 AND width >= 2.4 AND feature IN ('barrier_wall', 'barrier_city_wall', 'historic_citywalls')
            UNION ALL
            SELECT -- line_barrier_areas
                ST_Difference(
                  ST_Reverse(ST_OffsetCurve(way, -width*0.5*NULLIF(!scale_denominator!*0.001*0.28,0), 'join=round')),
                  COALESCE(
                    (SELECT
                        ST_Union(ST_Buffer(way, width*0.5*NULLIF(!scale_denominator!*0.001*0.28,0), 'endcap=flat join=round'))
                      FROM line_barriers_all
                      WHERE feature IN ('barrier_wall', 'barrier_city_wall', 'historic_citywalls')
                        AND osm_id != l1.osm_id
                    ),
                    ST_SetSRID('GEOMETRYCOLLECTION EMPTY'::geometry, 3857)
                  )
                ) AS way,
                'line_barrier_areas' AS road_layer,
                feature,
                'outer' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                CASE WHEN height <= 0.5 THEN 'yes' ELSE 'no' END AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                z_order
              FROM line_barriers_all AS l1
                WHERE z(!scale_denominator!) >= 18 AND width >= 2.4 AND feature IN ('barrier_wall', 'barrier_city_wall', 'historic_citywalls')
            UNION ALL
            SELECT -- ferry_routes
                way,
                'ferry_routes' AS road_layer,
                'ferry' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                0 AS width,
                0 AS casing_width,
                0 AS layernotnull,
                osm_id,
                0 AS z_order
              FROM planet_osm_line
              WHERE route = 'ferry'
                AND osm_id > 0 -- we do not want route relations here because they contain other geometries (ferry terminals as platforms etc.)
                AND way && !bbox!
            UNION ALL
            SELECT -- goods_conveyor
                way,
                'goods_conveyor' AS road_layer,
                'goods_conveyor' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                0 AS width,
                0 AS casing_width,
                COALESCE(layer,0) AS layernotnull,
                osm_id,
                0 AS z_order
              FROM planet_osm_line
              WHERE man_made = 'goods_conveyor'
                AND (tags->'location' NOT IN ('underground') OR (tags->'location') IS NULL)
                AND (tunnel NOT IN ('yes', 'culvert') OR tunnel IS NULL)
                AND way && !bbox!
                AND z(!scale_denominator!) >= 14
            UNION ALL
            SELECT -- pipeline casing
                way,
                'pipeline_casing' AS road_layer,
                'pipeline' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                -- pipelines get layered strictly by layer tag - hence we promote that to bridge/tunnel
                CASE WHEN layernotnull < 0 THEN 'yes' ELSE 'no' END AS int_tunnel,
                CASE WHEN layernotnull > 0 THEN 'yes' ELSE 'no' END AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                dasharrays[1] AS construction,
                substance AS service,
                'no' AS link,
                dasharrays[4] AS connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                pipe_casing AS width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM pipelines_all
            UNION ALL
            SELECT -- pipeline fill
                way,
                'pipeline_fill' AS road_layer,
                'pipeline' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                -- pipelines get layered strictly by layer tag - hence we promote that to bridge/tunnel
                CASE WHEN layernotnull < 0 THEN 'yes' ELSE 'no' END AS int_tunnel,
                CASE WHEN layernotnull > 0 THEN 'yes' ELSE 'no' END AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                dasharrays[2] AS construction,
                substance AS service,
                'no' AS link,
                dasharrays[4] AS connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                pipe_fill AS width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM pipelines_all
            UNION ALL
            SELECT -- pipeline flange
                way,
                'pipeline_flange' AS road_layer,
                'pipeline' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                -- pipelines get layered strictly by layer tag - hence we promote that to bridge/tunnel
                CASE WHEN layernotnull < 0 THEN 'yes' ELSE 'no' END AS int_tunnel,
                CASE WHEN layernotnull > 0 THEN 'yes' ELSE 'no' END AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                dasharrays[3] AS construction,
                substance AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                flange_width AS width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM pipelines_all
            UNION ALL
            SELECT -- piers_poly_main
                way,
                'piers_poly_main' AS road_layer,
                'pier' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                material AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                mooring AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                way_pixels AS width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM piers_poly_all
            UNION ALL
            SELECT -- piers_poly_backdrop
                way,
                'piers_poly_backdrop' AS road_layer,
                'pier' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                material AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                mooring AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                way_pixels AS width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM piers_poly_all
              WHERE mooring = 'yes'
            UNION ALL
            SELECT -- piers_line_main
                way,
                'piers_line_main' AS road_layer,
                'pier' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                material AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                mooring AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM piers_line_all
            UNION ALL
            SELECT -- piers_line_backdrop
                way,
                'piers_line_backdrop' AS road_layer,
                'pier' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                material AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                mooring AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM piers_line_all
              WHERE width >= 10 AND mooring = 'yes'
            UNION ALL
            SELECT -- piers_line_symbols
                (ST_Dump(
                  CASE
                    WHEN length < 3.0*width THEN ST_LineInterpolatePoint(way, 0.5)
                    WHEN length < 5.0*width THEN ST_Collect(ST_LineInterpolatePoint(way, 0.25), ST_LineInterpolatePoint(way, 0.75))
                    ELSE ST_Collect(ARRAY[ST_LineInterpolatePoint(way, 0.2), ST_LineInterpolatePoint(way, 0.5), ST_LineInterpolatePoint(way, 0.8)])
                  END
                )).geom AS way,
                'piers_line_symbols' AS road_layer,
                'pier' AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                material AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                mooring AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                (CASE WHEN length < width THEN length ELSE width END) AS width,
                0 AS casing_width,
                layernotnull,
                osm_id,
                z_order
              FROM 
                (SELECT
                    way,
                    ST_Length(way)/NULLIF(!scale_denominator!*0.001*0.28,0) AS length,
                    width,
                    floating,
                    mooring,
                    material,
                    layernotnull,
                    osm_id,
                    z_order
                  FROM piers_line_all
                  WHERE width >= 10 AND mooring = 'yes'
                ) AS piers_wide_mooring
            UNION ALL
            SELECT -- landuse_overlay
                way,
                'landuse_overlay' AS road_layer,
                COALESCE(
                  ('landuse_' || landuse),
                  ('military_' || military)
                ) AS feature,
                'null' AS path_type,
                'null' AS intermittent,
                'null' AS seasonal,
                'null' AS int_surface,
                'no' AS int_tunnel,
                'no' AS int_bridge,
                'null' AS int_lanes,
                'null' AS int_access,
                'null' AS construction,
                'null' AS service,
                'no' AS link,
                'null' connect_type,
                0 AS width_lane,
                0 AS width_nominal,
                0 AS width_max,
                way_area/NULLIF(POW(!scale_denominator!*0.001*0.28,2),0) AS width,
                0 AS casing_width,
                0 AS layernotnull,
                osm_id,
                0 AS z_order
              FROM planet_osm_polygon
              WHERE (landuse = 'military' OR military = 'danger_area')
                AND building IS NULL
                AND way && !bbox!
            ) AS roads_sublayers
          -- this is the full ordering of the roads stack
          ORDER BY
            CASE
              WHEN int_bridge IN ('yes') THEN layernotnull + 100
              WHEN int_tunnel NOT IN ('no') THEN layernotnull - 100
              ELSE 0
            END,
            -- this defines the ordering of layers as far as it has priority over the
            -- layer and z_oder of normal non-bridge and non-tunnel features, that is:
            --  * the non-roads layers
            --  * the casing-background-fill progression
            -- ordering beyond that is defined later because
            -- it is subordinate to the layer and z_oder
            CASE
              -- this is bridges only so it comes after all the non-bridge layers and before the road bridge layers
              WHEN road_layer = 'waterway_supplement' THEN -1
              WHEN road_layer = 'waterway_bridges_casing' THEN 0
              WHEN road_layer = 'waterway_bridges_fill' THEN 1
              WHEN road_layer = 'piers_poly_main' THEN 2
              WHEN road_layer = 'piers_line_main' THEN 2
              WHEN road_layer = 'piers_line_symbols' THEN 2
              WHEN road_layer = 'piers_poly_backdrop' THEN 2
              WHEN road_layer = 'piers_line_backdrop' THEN 2
              WHEN road_layer = 'landuse_overlay' THEN 3
              WHEN road_layer = 'line_barriers' THEN 4
              WHEN road_layer = 'line_barrier_areas' THEN 5
              WHEN road_layer = 'ferry_routes' THEN 6
              WHEN road_layer = 'tc_casing' THEN 7
              WHEN road_layer = 'area_casing' THEN 7
              WHEN road_layer = 'junction_casing' THEN 7
              WHEN road_layer = 'casing' THEN 7
              WHEN road_layer = 'background' THEN 8
              WHEN road_layer = 'background_bridge' THEN 8
              WHEN road_layer = 'area_fill' THEN 9
              WHEN road_layer = 'junction_fill' THEN 9
              WHEN road_layer = 'fill' THEN 9
              WHEN road_layer = 'fill_bridge' THEN 9
              WHEN road_layer = 'fill_lanes' THEN 9
              WHEN road_layer = 'parkings_lane' THEN 9
              WHEN road_layer = 'centerline' THEN 9
              WHEN road_layer = 'lanes' THEN 9
              WHEN road_layer = 'access' THEN 9
              WHEN road_layer = 'tc_fill' THEN 9
              WHEN road_layer = 'crossings_background' THEN 9
              WHEN road_layer = 'crossings' THEN 9
              WHEN road_layer = 'pipeline_casing' THEN 10
              WHEN road_layer = 'pipeline_fill' THEN 10
              WHEN road_layer = 'pipeline_flange' THEN 10
              WHEN road_layer = 'centerline_top' THEN 11
            END,
            layernotnull,
            CASE
              WHEN feature IN ('highway_construction', 'railway_construction', 'aeroway_construction') THEN 0
              ELSE 1
            END,
            CASE
              WHEN connect_type IN ('bridge_connect') THEN 0
              ELSE 1
            END,
            z_order NULLS FIRST,
            CASE
              WHEN road_layer = 'waterway_supplement' THEN -1
              WHEN road_layer = 'waterway_bridges_casing' THEN 0
              WHEN road_layer = 'waterway_bridges_fill' THEN 1
              WHEN road_layer = 'piers_poly_main' THEN 2
              WHEN road_layer = 'piers_line_main' THEN 3
              WHEN road_layer = 'piers_line_symbols' THEN 4
              WHEN road_layer = 'piers_poly_backdrop' THEN 5
              WHEN road_layer = 'piers_line_backdrop' THEN 6
              WHEN road_layer = 'landuse_overlay' THEN 7
              WHEN road_layer = 'line_barriers' THEN 8
              WHEN road_layer = 'line_barrier_areas' THEN 9
              WHEN road_layer = 'ferry_routes' THEN 10
              WHEN road_layer = 'pipeline_casing' THEN 11
              WHEN road_layer = 'tc_casing' THEN 12
              WHEN road_layer = 'area_casing' THEN 13
              WHEN road_layer = 'junction_casing' THEN 14
              WHEN road_layer = 'casing' THEN 15
              WHEN road_layer = 'background' THEN 16
              WHEN road_layer = 'background_bridge' THEN 17
              WHEN road_layer = 'area_fill' THEN 18
              WHEN road_layer = 'junction_fill' THEN 19
              WHEN road_layer = 'fill' THEN 20
              WHEN road_layer = 'fill_bridge' THEN 21
              WHEN road_layer = 'fill_lanes' THEN 22
              WHEN road_layer = 'parkings_lane' THEN 23
              WHEN road_layer = 'centerline' THEN 24
              WHEN road_layer = 'lanes' THEN 25
              WHEN road_layer = 'access' THEN 26
              WHEN road_layer = 'tc_fill' THEN 27
              WHEN road_layer = 'pipeline_fill' THEN 28
              WHEN road_layer = 'pipeline_flange' THEN 29
              WHEN road_layer = 'centerline_top' THEN 30
              WHEN road_layer = 'crossings_background' THEN 31
              WHEN road_layer = 'crossings' THEN 32
            END,
            CASE
              WHEN substr(feature, 1, 16) = 'highway_sidewalk' THEN 0
              WHEN feature = 'highway_lane_parking' THEN 1
              WHEN feature = 'highway_lane_cycle' THEN 2
              WHEN feature = 'highway_lane_bus' THEN 3
              ELSE 4
            END,
            -- order by how permissive it is to the target map user
            CASE
              WHEN int_access IN ('no') THEN 0
              WHEN int_access IN ('bus') THEN 1
              WHEN int_access IN ('foot') THEN 2
              WHEN int_access IN ('horse') THEN 3
              WHEN int_access IN ('bicycle') THEN 4
              WHEN int_access IN ('vehicle') THEN 5
              WHEN int_access IN ('light') THEN 6
              WHEN int_access IN ('bus+light') THEN 7
              WHEN int_access IN ('foot+light') THEN 8
              WHEN int_access IN ('horse+light') THEN 9
              WHEN int_access IN ('bicycle+light') THEN 10
              WHEN int_access IN ('vehicle+light') THEN 11
              ELSE 10
            END,
            CASE WHEN int_surface IN ('unpaved') THEN 0 ELSE 1 END,
            CASE WHEN int_bridge IN ('mountain_pass', 'ford_node') THEN 1 ELSE 0 END,
            osm_id
        ) AS roads_sql
    properties:
      cache-features: true
      minzoom: 10
